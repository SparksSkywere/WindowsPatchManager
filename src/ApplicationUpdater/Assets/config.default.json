{
  "general": {
    "autoCheckUpdates": true,
    "checkIntervalHours": 24,
    "createBackups": true,
    "backupDirectory": "backups",
    "showOnlyUpdatable": false,
    "startMinimized": false,
    "allowInstallerDesktopShortcuts": false,
    "theme": "system"
  },
  "updateSources": {
    "winget": {
      "enabled": true,
      "priority": 1
    },
    "chocolatey": {
      "enabled": true,
      "priority": 2
    },
    "gitHub": {
      "enabled": true,
      "priority": 3
    },
    "microsoftStore": {
      "enabled": true,
      "priority": 4
    },
    "wsl": {
      "enabled": true,
      "priority": 5
    },
    "microsoftOffice": {
      "enabled": true,
      "priority": 6
    }
  },
  "github": {
    "enabled": true,
    "token": "",
    "repositories": [
      {
        "owner": "",
        "repo": "",
        "displayName": "",
        "installedVersion": "",
        "assetPattern": ".exe"
      }
    ],
    "selfUpdate": {
      "enabled": true,
      "owner": "SparksSkywere",
      "repo": "WindowsPatchManager",
      "assetPattern": "Setup"
    }
  },
  "windowsUpdate": {
    "enabled": true,
    "includeDrivers": true,
    "includeOptional": false,
    "cveScanEnabled": true,
    "prioritizeSecurity": true,
    "securityUpdatesOnly": false,
    "queryMsrcOnline": true,
    "msrcMonthsToScan": 3,
    "msrcCriticalAndImportantOnly": true,
    "showUninstallableMsrcGaps": false
  },
  "wsl": {
    "enabled": true,
    "includeDistroPackages": true
  },
  "exclusions": {
    "programs": [],
    "publishers": [],
    "keywords": [],
    "packageIds": []
  },
  "updateBehavior": {
    "requireConfirmation": false,
    "maxConcurrentUpdates": 2,
    "restartIfRequired": false,
    "includeUnknown": true,
    "includePinned": false,
    "acceptAgreements": true,
    "silent": true
  },
  "notifications": {
    "showUpdateAvailable": true,
    "showUpdateComplete": true,
    "showErrors": true
  }
}
