<Window x:Class="ApplicationUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Patch Manager"
        Height="720" Width="1100"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="F6" Command="{Binding CheckUpdatesCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyCommand_Executed" CanExecute="CopyCommand_CanExecute"/>
    </Window.CommandBindings>

    <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Menu bar (Windows standard) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Scan programs" InputGestureText="F5" Command="{Binding ScanCommand}"/>
                <MenuItem Header="_Check for updates" InputGestureText="F6" Command="{Binding CheckUpdatesCommand}"/>
                <Separator/>
                <MenuItem Header="_Export list..." InputGestureText="Ctrl+S" Command="{Binding ExportCommand}"/>
                <MenuItem Header="Open _config folder" Command="{Binding OpenConfigFolderCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="Select _none" Command="{Binding SelectNoneCommand}"/>
                <MenuItem Header="Select _updates only" Command="{Binding SelectUpdatesOnlyCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show updates only" IsCheckable="True" IsChecked="{Binding ShowUpdatesOnly}"/>
                <Separator/>
                <MenuItem Header="Clear _log" Command="{Binding ClearLogCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Update selected" Command="{Binding UpdateSelectedCommand}"/>
                <MenuItem Header="Update _all available" Command="{Binding UpdateAllCommand}"/>
                <Separator/>
                <MenuItem Header="Search packages to _install" Command="{Binding SearchCatalogCommand}"/>
                <MenuItem Header="Install s_elected" Command="{Binding InstallSelectedCommand}"/>
                <MenuItem Header="_Load installed (uninstall)" Command="{Binding LoadUninstallListCommand}"/>
                <MenuItem Header="Un_install selected" Command="{Binding UninstallSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="Show update _history" Command="{Binding ShowUpdateHistoryCommand}"/>
                <MenuItem Header="_Back from history" Command="{Binding BackToAvailableUpdatesCommand}"/>
                <Separator/>
                <MenuItem Header="Create daily schedule..." Command="{Binding CreateScheduleCommand}"/>
                <MenuItem Header="Remove schedule" Command="{Binding RemoveScheduleCommand}"/>
                <Separator/>
                <MenuItem Header="_Options..." Click="Options_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Send _feedback on GitHub…" Click="Feedback_Click"
                          ToolTip="Open the GitHub Issues page to report bugs or request features"/>
                <MenuItem Header="Open Git_Hub repository…" Click="GitHub_Click"/>
                <MenuItem Header="View _releases…" Click="Releases_Click"/>
                <Separator/>
                <MenuItem Header="_About Windows Patch Manager" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar (actions change with tab via visibility) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <!-- Update tabs -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Visibility="{Binding IsUpdateTab, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Scan" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ScanCommand}" ToolTip="Scan (F5)"/>
                    <Button Content="Check updates" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckUpdatesCommand}" ToolTip="Check for updates (F6)"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrushSubtle}" Margin="8,4"/>
                    <Button Content="Update selected" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UpdateSelectedCommand}"/>
                    <Button Content="Update all" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UpdateAllCommand}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrushSubtle}" Margin="8,4"/>
                    <Button Content="Options" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Options_Click"/>
                </StackPanel>

                <!-- Install tab -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Visibility="{Binding IsInstallTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Package:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource MutedTextStyle}"/>
                    <TextBox Width="260" VerticalAlignment="Center"
                             Text="{Binding CatalogQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search winget catalog by name or ID"/>
                    <Button Content="Search" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"
                            Command="{Binding SearchCatalogCommand}"/>
                    <Button Content="Install selected" Style="{StaticResource ToolbarButtonStyle}" Margin="4,0,0,0"
                            Command="{Binding InstallSelectedCommand}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrushSubtle}" Margin="8,4"/>
                    <Button Content="Options" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Options_Click"/>
                </StackPanel>

                <!-- Uninstall tab -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Visibility="{Binding IsUninstallTab, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Load installed" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoadUninstallListCommand}"
                            ToolTip="List packages installed via winget"/>
                    <Button Content="Uninstall selected" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UninstallSelectedCommand}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderBrushSubtle}" Margin="8,4"/>
                    <Button Content="Options" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Options_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource MutedTextStyle}"/>
                    <TextBox Width="200" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter the current list"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16" Margin="0,0,8,0"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="14" Height="14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                 StrokeDashArray="2.5 1.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="StatusSpinnerRotate"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" MinWidth="200" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedTextStyle}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProgressPercentText}"
                               MinWidth="36" Margin="0,0,8,0"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <ProgressBar Width="140" Height="14"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="8,1" Margin="6,0,0,0"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="0" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Padding="10,6,10,6"
                    BorderBrush="{DynamicResource BorderBrushSubtle}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Select all" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectAllCommand}"/>
                    <Button Content="Select none" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectNoneCommand}"/>
                    <Button Content="Select updates" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SelectUpdatesOnlyCommand}"
                            Visibility="{Binding IsUpdateTab, Converter={StaticResource BoolToVisibility}}"/>
                    <CheckBox Content="Show updates only" Margin="12,0,0,0"
                              IsChecked="{Binding ShowUpdatesOnly}" VerticalAlignment="Center"
                              Visibility="{Binding IsUpdateTab, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="10,8,10,0" Background="{DynamicResource WindowBackgroundBrush}">
                <TabControl DockPanel.Dock="Top"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Margin="0,0,0,6"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderThickness="0">
                    <TabItem Header="Programs"/>
                    <TabItem Header="Drivers"/>
                    <TabItem Header="Windows Update / CVE"/>
                    <TabItem Header="Install"/>
                    <TabItem Header="Uninstall"/>
                </TabControl>

                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <ListView x:Name="ProgramList"
                                  ItemsSource="{Binding ActiveView}"
                                  BorderThickness="0"
                                  AlternationCount="2"
                                  SelectionMode="Extended"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  GridViewColumnHeader.Click="ProgramList_ColumnHeader_Click"
                                  PreviewMouseRightButtonDown="ProgramList_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="ProgramList_ContextMenuOpening">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource ProgramListViewItemStyle}"/>
                            </ListView.Resources>
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="ProgramContextMenu">
                                    <MenuItem Header="Install specific version…" Click="InstallSpecificVersion_Click"
                                              ToolTip="Choose a published version to install (upgrade or downgrade)"/>
                                    <MenuItem Header="Exclude from updates" Click="ExcludeProgram_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CopyCellMenuItem" Header="Copy cell" Click="CopyCell_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Copy Package ID" Click="CopyPackageId_Click"/>
                                    <MenuItem Header="Copy name" Click="CopyName_Click"/>
                                    <MenuItem Header="Copy Current version" Click="CopyVersion_Click"/>
                                    <MenuItem Header="Copy Available version" Click="CopyAvailable_Click"/>
                                    <MenuItem Header="Copy Source" Click="CopySource_Click"/>
                                    <MenuItem Header="Copy Publisher" Click="CopyPublisher_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Copy row (tab-separated)" Click="CopyRow_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource ThemedGridViewColumnHeader}">
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.Header>
                                            <!-- Select / deselect all rows; shows indeterminate when partially selected -->
                                            <CheckBox IsThreeState="True"
                                                      IsChecked="{Binding DataContext.SelectAllChecked, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      ToolTip="Select all / deselect all"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Focusable="False"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          ToolTip="Select this item"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Name" Width="250">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="{Binding UpdateAvailable, Converter={StaticResource BoolToBold}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Current version" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Available version" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AvailableVersion}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Severity" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Severity}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="{Binding IsSecurityUpdate, Converter={StaticResource BoolToBold}}"
                                                           ToolTip="{Binding Severity}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="CVE" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CveIds}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CveIds}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="KB" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding KbId}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding KbId}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Status" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UpdateStatus}"
                                                           Foreground="{Binding UpdateAvailable, Converter={StaticResource UpdateStatusBrush}}"
                                                           FontWeight="{Binding UpdateAvailable, Converter={StaticResource BoolToBold}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Progress" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="16">
                                                    <ProgressBar Minimum="0" Maximum="100" Height="14"
                                                                 Value="{Binding ProgressPercent, Converter={StaticResource ProgressValue}}"
                                                                 Visibility="{Binding ProgressPercent, Converter={StaticResource ProgressBarVisibility}}"/>
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Last updated" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastUpdated}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Source" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Package / ID" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PackageId}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding PackageId}"
                                                           Style="{StaticResource MutedTextStyle}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Publisher" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Publisher}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Publisher}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Empty state -->
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                                IsHitTestVisible="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="{Binding EmptyStateTitle}"
                                           FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding EmptyStateDetail}"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="Show history"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ShowUpdateHistoryCommand}"
                                            Visibility="{Binding ShowHistoryButton, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="Search packages"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SearchCatalogCommand}"
                                            Visibility="{Binding IsInstallTab, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="Load installed"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding LoadUninstallListCommand}"
                                            Visibility="{Binding IsUninstallTab, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="Scan" Margin="8,0,0,0"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding ScanCommand}"
                                            Visibility="{Binding IsUpdateTab, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- History mode banner -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}"
                                BorderThickness="0,0,0,1"
                                Padding="10,6"
                                Visibility="{Binding IsShowingHistory, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Back"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding BackToAvailableUpdatesCommand}"/>
                                <TextBlock Text="History view"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource BusyOverlayBrush}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                IsHitTestVisible="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="56" Height="56" Margin="0,0,0,10" HorizontalAlignment="Center">
                                    <Ellipse Width="50" Height="50"
                                             Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="4"
                                             StrokeDashArray="3 1.6"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="BusyOverlaySpin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                                        From="0" To="360" Duration="0:0:0.85"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="BusyOverlaySpin"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{Binding ProgressPercentText}"
                                           FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding BusyOverlayText}"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="480"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ProgressBar Width="300" Height="14" Margin="0,14,0,0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ProgressValue}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <GroupBox Grid.Row="2" Header="Log" Margin="10,8,10,10"
                      Background="{DynamicResource PanelBackgroundBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right"
                            Content="Clear" Padding="8,2" Margin="0,0,0,4"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ClearLogCommand}"/>
                    <ListBox ItemsSource="{Binding LogEntries}"
                             BorderThickness="0"
                             FontFamily="{StaticResource AppFontMono}"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
