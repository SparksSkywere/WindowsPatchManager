<Window x:Class="ApplicationUpdater.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Height="620" Width="580"
        MinHeight="520" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28"
                    IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource ToolbarButtonStyle}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Startup &amp; scanning" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Automatically check for updates on launch"
                                  IsChecked="{Binding AutoCheckUpdates}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Check interval (hours):" VerticalAlignment="Center" Width="160"/>
                            <TextBox Width="60" Text="{Binding CheckIntervalHours}"/>
                        </StackPanel>
                        <CheckBox Content="Write a backup manifest before installing updates"
                                  IsChecked="{Binding CreateBackups}" Margin="0,10,0,0"/>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="Label"
                                  Width="280" HorizontalAlignment="Left"/>
                        <TextBlock Text="Default is System (follows Windows light/dark). Other options are era styles from Chronolog (Windows 95 through Windows 11 Dark)."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Feedback" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="Report issues or request features on GitHub:"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Button Content="Open GitHub feedback…" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Padding="10,4" Command="{Binding OpenFeedbackCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="https://github.com/SparksSkywere/WindowsPatchManager/issues"/>

                        <TextBlock Text="Desktop shortcuts" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="Allow installers to create desktop shortcuts during updates"
                                  IsChecked="{Binding AllowInstallerDesktopShortcuts}"/>
                        <TextBlock Text="Off by default. When off, new desktop shortcuts created by package installers during an update run are removed afterward."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ShortcutStatus}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create desktop shortcut" Padding="10,4" Margin="0,0,8,0"
                                    Command="{Binding CreateDesktopShortcutCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="Create a Windows Patch Manager shortcut on your desktop"/>
                            <Button Content="Remove desktop shortcut" Padding="10,4"
                                    Command="{Binding RemoveDesktopShortcutCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="Remove the Windows Patch Manager desktop shortcut if present"/>
                        </StackPanel>

                        <TextBlock Text="Update sources" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="Windows Package Manager (winget)" IsChecked="{Binding WingetEnabled}"/>
                        <CheckBox Content="Chocolatey" IsChecked="{Binding ChocolateyEnabled}"/>
                        <CheckBox Content="GitHub Releases" IsChecked="{Binding GitHubEnabled}"/>
                        <CheckBox Content="Windows Update / Drivers / CVE patches" IsChecked="{Binding WindowsUpdateEnabled}"/>

                        <TextBlock Text="GitHub tracked projects" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="One repo per line: owner/repo|Display Name|assetPattern  (example: myorg/chronolog|Chronolog|.exe)"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding GitHubReposText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                        <TextBlock Text="Optional GitHub token (PAT) for rate limits / private repos" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding GitHubToken, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Check GitHub for Windows Patch Manager self-update"
                                  IsChecked="{Binding SelfUpdateEnabled}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Self-update repo:" VerticalAlignment="Center" Width="120"/>
                            <TextBox Width="220" Text="{Binding SelfUpdateRepo, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="owner/repo"/>
                        </StackPanel>

                        <TextBlock Text="Configuration file" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding ConfigPath}" IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="{DynamicResource HeaderBackgroundBrush}"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushSubtle}"
                                 CaretBrush="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Install behavior" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Silent installers when supported" IsChecked="{Binding Silent}"/>
                        <CheckBox Content="Include packages with unknown version (and repair them)"
                                  IsChecked="{Binding IncludeUnknown}" Margin="0,6,0,0"/>
                        <CheckBox Content="Include pinned packages" IsChecked="{Binding IncludePinned}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Max concurrent updates:" VerticalAlignment="Center" Width="160"/>
                            <TextBox Width="60" Text="{Binding MaxConcurrentUpdates}"/>
                        </StackPanel>
                        <TextBlock Text="Keep concurrency at 1–2 for more reliable installs. Unknown-version apps are force-reinstalled so Current is replaced with the available version."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Exclusions">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="One entry per line. Matching programs are skipped during update checks."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Program names" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExcludedProgramsText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Publishers" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBox Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExcludedPublishersText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Name keywords" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBox Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExcludedKeywordsText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Package IDs" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBox Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExcludedPackageIdsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notifications">
                <StackPanel Margin="12">
                    <CheckBox Content="Notify when updates are available" IsChecked="{Binding ShowUpdateAvailable}"/>
                    <CheckBox Content="Notify when updates complete" IsChecked="{Binding ShowUpdateComplete}" Margin="0,8,0,0"/>
                    <CheckBox Content="Show error dialogs" IsChecked="{Binding ShowErrors}" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
