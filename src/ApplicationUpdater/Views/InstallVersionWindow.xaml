<Window x:Class="ApplicationUpdater.Views.InstallVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install specific version"
        Height="420" Width="480"
        MinHeight="360" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel Margin="14" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="InstallButton" Content="Install selected version" Width="160" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="Install_Click" Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False"/>
            <Button Content="Cancel" Width="88" Height="28"
                    IsCancel="True" Click="Cancel_Click" Style="{StaticResource ToolbarButtonStyle}"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Install specific version"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"
                       TextWrapping="Wrap"
                       Text="Pick a published version to install. Use this to upgrade or downgrade when winget supports that package version."/>

            <TextBlock Text="Available versions" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid MinHeight="200">
                <ListBox x:Name="VersionList"
                         SelectionMode="Single"
                         SelectionChanged="VersionList_SelectionChanged"
                         BorderBrush="{DynamicResource BorderBrushSubtle}"
                         BorderThickness="1"/>
                <TextBlock x:Name="LoadingText"
                           Text="Loading versions from winget…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"/>
            </Grid>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
