<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Default light brushes (fallbacks before ThemeManager.Apply runs).
      ThemeManager removes this dictionary and injects a full light/dark set at runtime.
    -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PanelElevatedBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF106EBE"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF005A9E"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF606060"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="ListAltRowBrush" Color="#FFF7F7F7"/>
    <SolidColorBrush x:Key="ListSelectionBrush" Color="#FFCCE8FF"/>
    <SolidColorBrush x:Key="ListHoverBrush" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="BusyOverlayBrush" Color="#AAF3F3F3"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFCCE4F7"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#FFC0C0C0"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="UpdateAvailableBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="UpdateOkBrush" Color="#FF606060"/>
</ResourceDictionary>
